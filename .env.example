# Application
APP_NAME=node-mind-server
APP_PORT=3001
APP_HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL
POSTGRES_DB=node_mind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/node_mind

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# RedisInsight
REDISINSIGHT_PORT=5540

# Mailpit / SMTP
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="Node Mind <noreply@node-mind.local>"
MAILPIT_UI_PORT=8025

# Auth
# Dummy bcrypt hash used for login timing protection when email does not exist.
AUTH_DUMMY_PASSWORD_HASH=$2a$12$C6UzMDM.H6dfI/f/IKcEe.6xCZDglKJ5f0Y4L0S6xBfgL84bF6gqG
